{
  "manifest_version": 3,
  "name": "Phishing Detector",
  "version": "2.1.0",
  "description": "Scans email links and message text for phishing (webmail + manual popup scan).",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan for Phishing"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
